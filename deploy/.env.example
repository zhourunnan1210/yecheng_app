# ==========================================
# 椰城项目 - 环境变量配置模板
#
# 使用方式：
#   1. cp .env.example .env
#   2. 填写下面所有必填项（不要留空）
#   3. docker-compose up -d --build
#
# 注意：docker-compose.yml 对数据库和 Redis 密码用了“必须提供”语法，
# 这里留空会让 compose 直接报错退出，而不是回退到默认弱口令。
# ==========================================

# --- MySQL 数据库（必填）---
MYSQL_ROOT_PASSWORD=
MYSQL_USER=yecheng
MYSQL_PASSWORD=

# --- Redis 缓存（必填）---
REDIS_PASSWORD=

# --- 阿里云 OSS 图片存储（可选）---
# 不使用 OSS 时可以留空：图片上传接口会失败，但不影响其它功能。
# AccessKey 只从这里注入，切勿写进配置文件提交到仓库。
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# --- CORS 允许的前端来源（可选）---
# 逗号分隔。默认只允许 localhost，部署后改成你的域名或服务器地址。
# CORS_ALLOWED_ORIGINS=http://localhost:8080,http://your-domain.com

# --- 文本向量服务（可选）---
# 用于人才/岗位的语义搜索与推荐。仓库不包含该服务
# （需另部署 Qwen3-Embedding + Qwen3-Reranker 模型服务），
# 不配置时相关接口会降级处理。
# EMBEDDING_SERVICE_URL=http://textembed:5000

# --- ImgStegano 数字水印服务（可选，均有默认值）---
# INPUT_DIR=/app/cache/input_pictures
# ENCODED_DIR=/app/cache/encoded_pictures
# DECODED_DIR=/app/cache/decoded_pictures
# ENCODER_OUTPUT_DIR=/app/cache/watermark/encoder
# MAX_RETRY=3
# TIMEOUT=60
